{
  "name": "@modular-prompt/root",
  "version": "0.17.0",
  "private": true,
  "description": "Modular prompt framework for generative AI",
  "bin": {
    "simple-chat": "./scripts/simple-chat.mjs",
    "experiment": "./scripts/experiment.mjs"
  },
  "scripts": {
    "build": "pnpm run -r build",
    "test": "pnpm run -r test",
    "test:run": "pnpm run -r --if-present test:run",
    "clean": "pnpm run -r clean",
    "clean:all": "pnpm run -r clean && rm -rf node_modules packages/*/node_modules",
    "dev": "pnpm --filter @modular-prompt/core run dev",
    "lint": "pnpm run -r lint",
    "typecheck": "pnpm run -r typecheck",
    "prepack:all": "pnpm run -r --if-present prepack",
    "simple-chat": "node packages/simple-chat/dist/cli.js",
    "experiment": "node packages/experiment/dist/run-comparison.js",
    "mlx:setup": "pnpm run setup-mlx -w @modular-prompt/driver",
    "mlx:test": "cd packages/driver/src/mlx-ml/python && UV_PROJECT_ENVIRONMENT=\"${MODULAR_PROMPT_HOME:-$HOME/.modular-prompt}/runtimes/mlx/.venv\" uv run python test_api_spec.py",
    "setup-mlx": "pnpm run setup-mlx -w @modular-prompt/driver",
    "setup-pytorch": "pnpm run setup-pytorch -w @modular-prompt/driver"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/node": "20.19.27",
    "@vitest/ui": "3.2.4",
    "semver": "7.7.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/otolab/modular-prompt.git"
  },
  "keywords": [
    "prompt",
    "ai",
    "llm",
    "modular",
    "framework"
  ],
  "author": "",
  "license": "MIT"
}
